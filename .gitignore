# Cohort data is fetched from Zenodo DOIs by R/00_download_cohorts.R,
# never redistributed here.
data/raw/*
data/harmonized/*
!data/raw/.gitkeep
!data/harmonized/.gitkeep

# Generated results and figures.
#
# The committed contents of results/ and figures/ are a REFERENCE RUN of the
# full compendium (15 gate-passing cohorts, 1000 null draws, seed 20260705),
# so a reviewer can inspect the tables and diff `make check` without waiting
# on the pipeline. `make clean-results` removes them; re-running regenerates
# them. Per-cohort score matrices are excluded -- they are large, and every
# downstream table is derived from them.
results/scores/

# Signature library is assembled from upstream at build time.
signatures/signatures.json
signatures/signature_provenance.csv
signatures/.cache/

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.Rhistory
.RData
.DS_Store
